{
  "pollIntervalMinutes": 15,
  "databasePath": "./data/appsentinel.db",
  "server": {
    "enabled": true,
    "port": 3456,
    "host": "0.0.0.0"
  },
  "classifier": {
    "provider": "local",
    "model": "rule-based"
  },
  "detection": {
    "windowMinutes": 60,
    "spikeThreshold": 3,
    "cooldownMinutes": 60,
    "minSeverity": "P1_CRITICAL"
  },
  "alerts": {
    "slack": {
      "enabled": false,
      "webhookUrl": "${SLACK_WEBHOOK_URL}"
    },
    "telegram": {
      "enabled": false,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "chatId": "${TELEGRAM_CHAT_ID}"
    },
    "webhook": {
      "enabled": false,
      "url": "${APPSENTINEL_WEBHOOK_URL}"
    }
  },
  "apps": [
    {
      "id": "subway-surfers-ios",
      "platform": "ios",
      "appId": "512939461",
      "name": "Subway Surfers",
      "countries": ["us", "gb"]
    },
    {
      "id": "spotify-android",
      "platform": "android",
      "appId": "com.spotify.music",
      "name": "Spotify",
      "countries": ["us"]
    }
  ]
}
