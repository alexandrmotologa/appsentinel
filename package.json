{
  "name": "appsentinel",
  "version": "1.0.0",
  "description": "Real-time mobile app review triage and incident alerting engine for App Store and Google Play feeds",
  "type": "module",
  "bin": {
    "appsentinel": "./bin/appsentinel.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/core/storage', {recursive:true}); fs.copyFileSync('src/core/storage/schema.sql', 'dist/core/storage/schema.sql')\"",
    "start": "tsx src/cli/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandrmotologa/appsentinel.git"
  },
  "keywords": [
    "mobile-apps",
    "app-store-monitoring",
    "incident-response",
    "crash-detection",
    "rss-feed",
    "slack-bot",
    "telegram-bot",
    "anomaly-detection",
    "sliding-window",
    "llm-triage",
    "typescript",
    "nodejs"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexandrmotologa/appsentinel/issues"
  },
  "homepage": "https://github.com/alexandrmotologa/appsentinel#readme",
  "dependencies": {
    "commander": "^12.0.0",
    "fast-xml-parser": "^4.5.0",
    "google-play-scraper": "^10.0.0",
    "picocolors": "^1.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
